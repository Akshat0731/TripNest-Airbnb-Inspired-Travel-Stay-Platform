<%layout("/layouts/boilerplate.ejs")-%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
            <h3>Create A New Listing</h3>
            <form action="/listings" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <input id="title" type="text" name="listing[title]" placeholder="Add a Cathcy Title" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please enter a listing title.</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <textarea id="description" type="text" name="listing[description]" placeholder="My New Sweet Home" class="form-control" required></textarea>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please enter a description.</div>
                </div>

                <div class="mb-3">
                    <label for="url" class="form-label">Image Link:</label>
                    <input id="url" type="text" name="listing[image][url]" placeholder="enter image/URLL link" class="form-control">
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price:</label>
                        <input id="price" class="form-control" type="number" name="listing[price]" placeholder="1200" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter a price.</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country:</label>
                        <input id="country" class="form-control" type="text" name="listing[country]" placeholder="India" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please enter a valid country name</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location:</label>
                    <input id="location" class="form-control" type="text" name="listing[location]" placeholder="Surat,Gujarat" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please enter a valid location name</div>
                </div>
                <br><br>
                <button class="btn add-btn">Add</button>
                <br><br>
            </form>
        </div>
    </div>
</body>