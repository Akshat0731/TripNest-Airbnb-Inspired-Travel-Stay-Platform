<%layout("/layouts/boilerplate.ejs")-%>

<body>
    <div class="row">
        <div class="col-6 offset-3 mb-3">
            <h3><%=place.title%></h3>
            <img src="<%=place.image.url%>" alt="listing_image" class="listImg">
            <p>Description: <%=place.description%></p>
            <p>Price: <b>&#8377;<%=place.price.toLocaleString("en-IN")%></b></p>
            <p>Location: <%=place.location%></p>
            <p>Country: <%=place.country%></p>
            <div class="row">
                <div class="col-6 btns">
                    <a href="/listings/<%=place._id%>/edit" class="btn edit-btn">Edit</a>
                    <form action="/listings/<%=place._id%>?_method=DELETE" method="post">
                        <button class="btn delete-btn offset-4">Delete</button>
                    </form>
                </div>
            </div>
        </div>
        <hr>

        <div class="col-6 offset-3 mb-3 mt-3">
            <h4>Leave a Review</h4>
            <form action="/listings/<%=place._id%>/reviews" method="post" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" rows="5" cols="30" class="form-control" required></textarea>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please add some comment for review.</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
            <p><b>All Reviews</b></p>
            <div class="row">
            <!-- <p><=place.reviews></p> -->
                <%for(review of place.reviews){%>
                    <div class="card col-5 ms-3 mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Joe</h5>
                            <p class="card-text"><%=review.comment%></p>
                            <p class="card-text"><%=review.rating%>stars</p>
                            <form action="/listings/<%=place._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST">
                                <button class="btn btn-sm btn-dark mb-3">Delete</button>
                            </form>
                        </div>
                    </div>
                <%}%>
            </div>
        </div>
    </div>
</body>