<%layout("/layouts/boilerplate.ejs")-%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
            <h3>Edit Your Listing</h3>

            <form action="/listings/<%=listing._id%>?_method=PUT" method="POST" novalidate class="needs-validation">

                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <input id="title" type="text" name="listing[title]" value="<%=listing.title%>" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please check this field.</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <textarea id="description" type="text" name="listing[description]" class="form-control" required><%=listing.description%></textarea>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please check this field.</div>
                </div>

                <div class="mb-3">
                    <label for="url" class="form-label">Image Link:</label>
                    <input id="url" type="text" name="listing[image][url]" value="<%=listing.image.url%>" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please check this field.</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price:</label>
                        <input id="price" class="form-control" type="number" name="listing[price]" value="<%=listing.price%>" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please check this field.</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country:</label>
                        <input id="country" class="form-control" type="text" name="listing[country]" value="<%=listing.country%>" required>
                        <div class="valid-feedback">Looks good!</div>
                        <div class="invalid-feedback">Please check this field.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location:</label>
                    <input id="location" class="form-control" type="text" name="listing[location]" value="<%=listing.location%>" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please check this field.</div>
                </div>

                <br><br>
                <button class="btn edit-btn">Edit</button>
                <br><br>

            </form>
        </div>
    </div>
</body>
